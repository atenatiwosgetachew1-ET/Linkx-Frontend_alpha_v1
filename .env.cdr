# CDR deployment — override these for the target server.
# Copy this file to .env and adjust values, or build with:
#   cp .env.cdr .env && npm run build:cdr

VITE_THEME=cdr
VITE_API_URL=https://CDR_SERVER_IP
VITE_BASE_URL=https://CDR_SERVER_IP
VITE_HEADER_ALLOWED_ORIGINS=https://CDR_PARENT_PROJECT_IP
VITE_SSO_ALLOWED_ORIGINS=https://CDR_PARENT_PROJECT_IP
VITE_PARENT_PROJECT_AUTHORIZE_URL=https://CDR_PARENT_PROJECT_IP/api/sso/authorize
VITE_PARENT_PROJECT_CLIENT_ID=linkx
VITE_PARENT_PROJECT_SCOPE=openid profile roles permissions
VITE_PARENT_PROJECT_REDIRECT_URI=https://CDR_SERVER_IP/auth/callback
VITE_ENABLE_CLIENT_LOGS=true
