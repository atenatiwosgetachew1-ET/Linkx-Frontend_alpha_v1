# Staging/production HTTPS frontend origin.
# Backend traffic is proxied by nginx so browser requests stay same-origin.
VITE_API_URL=https://172.27.23.21
VITE_BASE_URL=https://172.27.23.21
VITE_HEADER_ALLOWED_ORIGINS=https://172.27.23.107
